{
  "env_file": "endpoint-minimax-m3.env",
  "llm": {"provider": "vllm", "model": "minimax-m3", "request_timeout": 180, "max_retries": 2},
  "mutator": {"temperature": 1.0, "max_tokens": 4096},
  "target": {"temperature": 0.0, "max_tokens": 4096},
  "evaluator": {"temperature": 0.0, "max_tokens": 2048},
  "manifest": "data/universal/smoke.json",
  "tool_catalog": "data/tool_catalog",
  "roots_file": "data/turn_seeds.json",
  "max_tool_iters": 8,
  "concurrency": 1,
  "turn_search": {
    "roots": 1, "branching_factor": 2, "width": 2, "depth": 5,
    "max_turns": 13, "max_candidates": 7, "repeats": 1,
    "renderer": "minimax_m3_chat", "max_generation_attempts": 3
  }
}
